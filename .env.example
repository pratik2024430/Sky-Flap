# Sky Flap: Aero Surge - Environment Configuration Template
# COPY THIS FILE TO .env AND FILL IN YOUR VALUES. DO NOT COMMIT .env TO VERSION CONTROL.

# Environment Mode (debug | beta | production)
ENVIRONMENT=debug

# Public Client AdMob Configuration (Ad Unit IDs)
ADMOB_APP_ID=ca-app-pub-3940256099942544~3347511713
ADMOB_BANNER_ID=ca-app-pub-3940256099942544/6300978111
ADMOB_INTERSTITIAL_ID=ca-app-pub-3940256099942544/1033173712
ADMOB_REWARDED_ID=ca-app-pub-3940256099942544/5224354917
ADMOB_APP_OPEN_ID=ca-app-pub-3940256099942544/9257395921

# Public Client Backend Endpoint (HTTPS)
BACKEND_API_URL=https://api.skyflap.com/v1

# Public Supabase Client Anon Key (REQUIRES ROW-LEVEL SECURITY (RLS) ENABLED ON ALL TABLES)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key-here

# Public Stripe Publishable Key (CLIENT-SIDE ONLY)
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# Local Storage Anti-Cheat Checksum Salt
APP_LOCAL_CHECKSUM_SALT=your_unique_local_salt_secret_key_here

# Game Parameter Overrides
INTERSTITIAL_INTERVAL_GAMES=4
APP_OPEN_AD_COOLDOWN_SEC=300
ACTIVE_SEASONAL_EVENT=cyberpunk

# ==============================================================================
# CRITICAL SECURITY REMINDER: SERVER-ONLY SECRETS
# THE FOLLOWING KEYS MUST NEVER APPEAR IN CLIENT-SIDE OR MOBILE APK CODE:
# - Stripe Secret Key (sk_live_...)
# - Supabase Service Role Key (service_role)
# - Database Connection URIs (PostgreSQL, MongoDB, Redis)
# - Firebase Admin SDK Credentials / Service Accounts
# - OAuth Client Secrets & JWT Signing Secrets
# - OpenAI, Gemini, SendGrid, Twilio, AWS Secret Access Keys
# ==============================================================================
